# Copier en .env (non versionné) : cp .env.example .env
# Même valeur sur la Jetson, le PC et tous les conteneurs.

# Numéro du département sur 2 chiffres (ex. 92). Plage 1 à 101, jamais 0.
# Voir docs/ROBOCAR_TO_DO_ROS2.md §6.
ROS_DOMAIN_ID=

ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# Zenoh : autre middleware ROS 2. Un routeur central sur le PC remplace la découverte DDS
# par multicast. Utile si le Wi-Fi gère mal le multicast (voir .env et §6).
# RMW_IMPLEMENTATION=rmw_zenoh_cpp

# GPS RTK (phase 7) : clé Polaris, uniquement ici, jamais dans le dépôt
# POLARIS_API_KEY=
