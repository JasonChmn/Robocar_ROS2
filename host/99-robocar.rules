# Noms stables pour les périphériques de la Robocar (Jetson, et PC si besoin).
# Installation : sudo cp 99-robocar.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
# Vérifier les IDs réels avec lsusb.

# ModemManager sonde les ports série au branchement (commandes AT) pour y chercher un modem.
# Il occupe alors le port quelques secondes (vesc-config échoue avec « Device or resource busy »)
# et envoie des octets parasites. ModemManager 1.10 (18.04) lit ID_MM_DEVICE_IGNORE sur le
# périphérique USB, pas sur le tty : d'où SUBSYSTEM=="usb".
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", ENV{ID_MM_DEVICE_IGNORE}="1"

# VESC (STM32 VCP) -> /dev/vesc
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", SYMLINK+="vesc", MODE="0666"

# LiDAR, adaptateur USB-série CP2102 ou CH340 -> /dev/lidar
# Si le GPS utilise aussi un de ces adaptateurs, distinguer par ATTRS{serial} ou KERNELS (port USB physique).
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="lidar", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="lidar", MODE="0666"

# OAK-D Lite (Luxonis, Movidius) : accès USB sans root
SUBSYSTEM=="usb", ATTRS{idVendor}=="03e7", MODE="0666"

# F710 (046d:c21f en mode X) : pas de règle. joy la trouve par device_id via /dev/input (groupe input).
